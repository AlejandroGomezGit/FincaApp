generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// core-api es el único dueño de las migraciones (prisma db push/migrate) de
// toda la base de datos, incluida esta tabla — aunque en tiempo de ejecución
// nunca la consulta directamente (ese es el trabajo de auth-service). Se
// mantiene declarada aquí solo para preservar la integridad referencial
// (Farm.userId) y el historial de esquema en un único lugar.
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farms         Farm[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Farm {
  id               Int       @id @default(autoincrement())
  name             String
  location         String?
  description      String?
  hectares         Float?
  lat              Float?
  lng              Float?
  locationResolved String?
  geocodedAt       DateTime?
  userId           Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  crops            Crop[]
  workers          Worker[]
  transactions     Transaction[]
  livestockBatches LivestockBatch[]
}

model Crop {
  id                    Int        @id @default(autoincrement())
  name                  String
  type                  CropType
  farmId                Int
  hectares              Float?
  plantingDate          DateTime?
  expectedHarvestDate   DateTime?
  status                CropStatus @default(ACTIVE)
  notes                 String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  farm                Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  activities          Activity[]
  harvestProjections  HarvestProjection[]
  transactions        Transaction[]
}

// Una actividad aplica a un Crop O a un LivestockBatch, nunca a ambos —
// exactamente uno de los dos debe estar presente. Esto se valida en el
// controller (activities.controller.js), no con un constraint de base de
// datos, siguiendo el estilo del resto del proyecto.
model Activity {
  id               Int              @id @default(autoincrement())
  name             String
  category         ActivityCategory
  cropId           Int?
  livestockBatchId Int?
  startDate        DateTime
  endDate          DateTime?
  status           ActivityStatus   @default(IN_PROGRESS)
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  crop           Crop?           @relation(fields: [cropId], references: [id], onDelete: Cascade)
  livestockBatch LivestockBatch? @relation(fields: [livestockBatchId], references: [id], onDelete: Cascade)
  jornales       Jornal[]
}

model Worker {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  idNumber  String?
  farmId    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farm     Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  jornales Jornal[]
}

model Jornal {
  id         Int      @id @default(autoincrement())
  workerId   Int
  activityId Int
  date       DateTime
  days       Float    @default(1)
  dailyValue Float
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  worker   Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model Transaction {
  id               Int             @id @default(autoincrement())
  farmId           Int
  cropId           Int?
  livestockBatchId Int?
  type             TransactionType
  category         TransactionCategory
  amount           Float
  date             DateTime
  description      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  farm           Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop           Crop?           @relation(fields: [cropId], references: [id], onDelete: SetNull)
  livestockBatch LivestockBatch? @relation(fields: [livestockBatchId], references: [id], onDelete: SetNull)
}

model HarvestProjection {
  id                 Int      @id @default(autoincrement())
  cropId             Int
  projectedDate      DateTime
  projectedQuantity  Float
  actualQuantity     Float?
  unit               String   @default("kg")
  unitPrice          Float?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  crop Crop @relation(fields: [cropId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────
// Ganado / aves. LivestockBatch es el lote (ej. "200 gallinas ponedoras" o
// "hato de leche"); Animal es opcional — solo se crea cuando de verdad tiene
// sentido llevar un registro por cabeza individual (ganado), no para aves de
// corral donde todo se maneja a nivel de lote. Health/Mortality pueden
// referenciar un animal puntual O el lote completo (animalId null).
// ─────────────────────────────────────────────────────────────────────────
model LivestockBatch {
  id              Int              @id @default(autoincrement())
  name            String
  species         LivestockSpecies
  purpose         LivestockPurpose
  farmId          Int
  quantity        Int              @default(1)
  acquisitionDate DateTime?
  status          LivestockStatus  @default(ACTIVE)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  farm              Farm               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animals           Animal[]
  activities        Activity[]
  transactions      Transaction[]
  healthRecords     HealthRecord[]
  productionRecords ProductionRecord[]
  mortalityRecords  MortalityRecord[]
}

model Animal {
  id        Int          @id @default(autoincrement())
  batchId   Int
  tag       String?
  sex       AnimalSex?
  birthDate DateTime?
  breed     String?
  status    AnimalStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  batch               LivestockBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  weightRecords       WeightRecord[]
  healthRecords       HealthRecord[]
  reproductionRecords ReproductionRecord[]
  mortalityRecords    MortalityRecord[]
}

model WeightRecord {
  id        Int      @id @default(autoincrement())
  animalId  Int
  date      DateTime
  weightKg  Float
  notes     String?
  createdAt DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
}

model HealthRecord {
  id          Int              @id @default(autoincrement())
  batchId     Int
  animalId    Int?
  type        HealthRecordType
  date        DateTime
  product     String?
  cost        Float?
  nextDueDate DateTime?
  notes       String?
  createdAt   DateTime         @default(now())

  batch  LivestockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  animal Animal?        @relation(fields: [animalId], references: [id], onDelete: Cascade)
}

model ReproductionRecord {
  id             Int              @id @default(autoincrement())
  animalId       Int
  type           ReproductionType
  date           DateTime
  expectedDate   DateTime?
  offspringCount Int?
  notes          String?
  createdAt      DateTime         @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
}

model ProductionRecord {
  id          Int            @id @default(autoincrement())
  batchId     Int
  date        DateTime
  productType ProductionType
  quantity    Float
  unit        String         @default("unidad")
  notes       String?
  createdAt   DateTime       @default(now())

  batch LivestockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model MortalityRecord {
  id        Int      @id @default(autoincrement())
  batchId   Int
  animalId  Int?
  date      DateTime
  quantity  Int      @default(1)
  cause     String?
  notes     String?
  createdAt DateTime @default(now())

  batch  LivestockBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  animal Animal?        @relation(fields: [animalId], references: [id], onDelete: SetNull)
}

enum CropType {
  CAFE
  PLATANO
  YUCA
  MAIZ
  AGUACATE
  FRIJOL
  OTRO
}

enum CropStatus {
  ACTIVE
  HARVESTED
  INACTIVE
}

enum ActivityCategory {
  SIEMBRA
  FERTILIZACION
  FUMIGACION
  PODA
  COSECHA
  MANTENIMIENTO
  RIEGO
  VACUNACION
  ALIMENTACION
  MANEJO_ANIMAL
  OTRO
}

enum ActivityStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  VENTA_COSECHA
  INSUMOS
  MAQUINARIA
  INFRAESTRUCTURA
  SERVICIOS_EXTERNOS
  JORNALES
  TRANSPORTE
  OTRO
}

enum LivestockSpecies {
  BOVINO
  AVES
  PORCINO
  OVINO
  CAPRINO
  EQUINO
  OTRO
}

enum LivestockPurpose {
  LECHE
  CARNE
  HUEVOS
  REPRODUCCION
  DOBLE_PROPOSITO
  OTRO
}

enum LivestockStatus {
  ACTIVE
  INACTIVE
}

enum AnimalSex {
  MACHO
  HEMBRA
}

enum AnimalStatus {
  ACTIVE
  SOLD
  DECEASED
}

enum HealthRecordType {
  VACUNA
  DESPARASITACION
  TRATAMIENTO
  REVISION
  OTRO
}

enum ReproductionType {
  MONTA
  INSEMINACION
  GESTACION_CONFIRMADA
  PARTO
  ABORTO
}

enum ProductionType {
  LECHE
  HUEVOS
  LANA
  OTRO
}
